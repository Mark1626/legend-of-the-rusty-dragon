# Copy to .env for local development, or set these as Vercel project variables.

# Required. On Neon use the POOLED endpoint: every concurrent invocation opens
# its own pool, so the direct endpoint runs out of connections quickly.
#
# TLS: when no sslmode is given, verify-full is added automatically. Do not
# settle for Neon's default `sslmode=require` — it encrypts but accepts ANY
# certificate, so it does not stop an impostor collecting your password. The
# local line below says `disable` on purpose: the throwaway container speaks no
# TLS at all, and being explicit about that is better than looking secure.
DATABASE_URL=postgres://dragon:dragon@localhost:55432/dragon?sslmode=disable

# How many connections one instance may hold. Small on purpose.
DB_MAX_CONNECTIONS=3

# `web` (default) is the retune; `irc` reproduces the original cadence.
PACING=web

# Override the heartbeat without a redeploy. Safe to change on a live game:
# every duration in the core is wall-clock, not a tick count.
# TICK_SECS=180

# The most ticks one request will replay before skipping the clock forward.
# MAX_CATCHUP_TICKS=24

# REQUIRED to let anyone sign up. The Realm is invitation-only: POST /api/join
# demands one of these keys. Unset means nobody can join — never that anybody
# can. Comma-separate several to rotate without locking anyone out: publish the
# new key, carry both while invitations are in flight, then drop the old one.
INVITE_KEY=change-me-before-you-share-this

# Signup attempts allowed per caller per window, counting failures. Counting
# failures is what bounds a leaked invitation key and closes the
# name-enumeration oracle.
# JOIN_ATTEMPTS_PER_WINDOW=10
# JOIN_WINDOW_SECS=3600

# Enables POST /api/admin. Administration is refused outright when unset.
# ADMIN_SECRET=

# Guards POST/GET /api/tick. The route is unauthenticated when unset, which is
# safe: a heartbeat that finds no tick owed takes no lock and writes nothing, so
# repeated calls inside one tick window cost a single indexed read each.
# CRON_SECRET=

# Fixes the world's random stream. Derived from the clock when unset.
# GAME_SEED=

# Local development only; on Vercel the platform serves static files.
# STATIC_DIR=public
# PORT=3000
